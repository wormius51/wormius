<script src="https://www.google.com/recaptcha/api.js" async defer></script> <!-- Load google recaptcha API -->

<script>
    function enableSubmitContact() {
        document.getElementById("submit-send-contact").disabled = false;
    }
</script>

<form method="post" action="/contact/send-email" class="contact-form col">
    <label for="name">Name</label>
    <br>
    <input type="text" name="name" placeholder="Name">
    <br>
    <label for="email">Email</label>
    <br>
    <input type="email" name="email" placeholder="Email">
    <br>
    <label for="subject">Subject</label>
    <br>
    <input type="text" name="subject" placeholder="Subject">
    <br>
    <label for="message">Message</label>
    <br>
    <textarea name="message" placeholder="Message"></textarea>
    <br>
    <div class="g-recaptcha" data-sitekey="<%= SITE_KEY %>" data-callback="enableSubmitContact"></div>
    <br> <!-- Google recaptcha element -->
    <input type="submit" id="submit-send-contact" value="Submit" disabled>
</form>